# ========================================
# Global .gitignore for dnd monorepo
# ========================================

# ========== OS Files ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ========== IDE / Editors ==========
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ========== Environment Files ==========
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ========== Logs ==========
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========== Debug Files ==========
*.pdb
*.dmp
crash-reports/

# ========== Secrets / Credentials ==========
*.pem
*.key
*.crt
*.p12
secrets/
credentials/

# ========== Archives ==========
*.zip
*.tar.gz
*.rar
*.7z

# ========== Temporary Files ==========
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

