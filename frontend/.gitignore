# ========================================
# Frontend .gitignore (React + Vite + TypeScript)
# ========================================

# ========== Dependencies ==========
node_modules/
.pnp
.pnp.js

# ========== Build Output ==========
dist/
dist-ssr/
build/
out/
.output/

# ========== Cache ==========
.vite/
.cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ========== Testing ==========
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ========== TypeScript ==========
*.tsbuildinfo
tsconfig.tsbuildinfo

# ========== Local Environment ==========
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ========== Editor Directories ==========
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ========== Debug Logs ==========
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========== OS Files ==========
.DS_Store
Thumbs.db

# ========== Misc ==========
*.local
*.sw?
*~

